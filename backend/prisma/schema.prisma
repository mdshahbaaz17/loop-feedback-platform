generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  feedback  Feedback[]
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  role        Role      @default(VIEWER)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model Feedback {
  id          String         @id @default(cuid())
  source      String
  content     String
  sentiment   Sentiment?
  status      FeedbackStatus @default(NEW)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes      FeedbackTheme[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

model Theme {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  feedbacks   FeedbackTheme[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], onDelete: Cascade)

  @@id([feedbackId, themeId])
}
